# Postgres connection string. Neon via the Vercel integration sets this for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Who can log in, as name:password pairs separated by commas.
APP_USERS=Rasmus:change-me,Tereza:change-me-too

# Any long random string. Used to sign the login cookie.
SESSION_SECRET=replace-with-a-long-random-string
